// Headless тест рушія (GameObject/Scene/колізії/self.go) - БЕЗ canvas,
// запускається на Linux цією сесією (на відміну від examples/dodge.nx,
// що потребує Windows Forms). Перевіряє суто ЛОГІКУ (не рендер).

import "../lib/engine.nx" {
    GameObject, createGameObject, BoxCollider, boxCollider,
    Scene, createScene, aabbOverlap, notifyCollision,
    updateAllScripts, checkCollisions
}

struct Bouncer {
    go: any
    vx: number
    hitCount: number

    func update(dt, canvas) {
        self.vx = self.vx + dt
    }

    func onCollide(other) {
        self.hitCount = self.hitCount + 1
        print("зіткнення з " + other.name + "! hitCount=" + toString(self.hitCount))
    }
}

// БЕЗ update() (навмисно) - цей скрипт існує ЛИШЕ щоб перевірити, що
// notifyCollision тихо пропускає скрипти БЕЗ onCollide (нижче) - update()
// тут ніде НЕ викликається (цей тест не викликає updateAllScripts/
// Engine.run()), тож порожній update() був би зайвим кодом, а не
// потрібною частиною "конвенції компонента".
struct SilentScript {
    go: any
    tag: string
}

// Базові перевірки: GameObject/Scene/findByName/aabbOverlap/update()/
// self.go/notifyCollision (напряму, БЕЗ checkCollisions).
func testBasics() {
    var fail = 0

    var scene = createScene()
    var a = createGameObject("A", 0, 0)
    var b = createGameObject("B", 5, 0)
    a.collider = boxCollider(10, 10)
    b.collider = boxCollider(10, 10)
    var bouncerA = Bouncer { go: 0, vx: 0, hitCount: 0 }
    a.addScript(bouncerA)
    var silent = SilentScript { go: 0, tag: "no-oncollide" }
    b.addScript(silent)
    scene.addObject(a)
    scene.addObject(b)

    if (len(scene.objects) != 2) { fail = fail + 1; print("FAIL: scene.objects довжина") }
    var found = scene.findByName("B")
    if (found.name != "B") { fail = fail + 1; print("FAIL: findByName") }

    if (aabbOverlap(0, 0, 10, 10, 5, 0, 10, 10) != true) { fail = fail + 1; print("FAIL: overlap мав бути true") }
    if (aabbOverlap(0, 0, 10, 10, 100, 0, 10, 10) != false) { fail = fail + 1; print("FAIL: overlap мав бути false") }

    bouncerA.update(0.016, 0)
    if (bouncerA.vx != 0.016) { fail = fail + 1; print("FAIL: bouncerA.vx") }

    // self.go - посилання на власника, проставлене addScript()
    var mover = a.scripts[0]
    if (mover.go.name != "A") { fail = fail + 1; print("FAIL: self.go не вказує на власника") }

    // notifyCollision - викликає onCollide, коли є; тихо пропускає,
    // коли немає (try/catch у engine.nx)
    notifyCollision(a, b)
    notifyCollision(b, a)
    if (bouncerA.hitCount != 1) { fail = fail + 1; print("FAIL: hitCount після зіткнення") }

    return fail
}

// checkCollisions()/updateAllScripts() - РЕАЛЬНИЙ регресійний тест на
// баг, знайдений живцем (22.09.2026): checkCollisions() усередині
// СЕБЕ викликає aabbOverlap/notifyCollision - файл, що імпортує ЛИШЕ
// checkCollisions (без цих двох поряд), падає в рантаймі з "Функція
// 'aabbOverlap' не оголошена" - САМЕ ТАК examples/dodge.nx був
// поламаний до цього фіксу (виявлено при написанні окремого
// демо-скрипта, не тестом - цей тест закриває ту прогалину). Нові
// об'єкти (НЕ 'a'/'b'/SilentScript із testBasics) - у SilentScript
// немає update(), а updateAllScripts() його вимагає.
func testFrameStepFunctions() {
    var fail = 0

    var scene2 = createScene()
    var c = createGameObject("C", 0, 0)
    var d = createGameObject("D", 3, 0)
    c.collider = boxCollider(10, 10)
    d.collider = boxCollider(10, 10)
    var bouncerC = Bouncer { go: 0, vx: 0, hitCount: 0 }
    c.addScript(bouncerC)
    scene2.addObject(c)
    scene2.addObject(d)

    updateAllScripts(scene2, 0.5, 0)
    if (bouncerC.vx != 0.5) { fail = fail + 1; print("FAIL: updateAllScripts не викликав update()") }

    checkCollisions(scene2)
    if (bouncerC.hitCount != 1) { fail = fail + 1; print("FAIL: checkCollisions не викликав onCollide через AABB-перетин") }

    return fail
}

func main() {
    var fail = testBasics() + testFrameStepFunctions()

    if (fail == 0) {
        print("УСІ ПЕРЕВІРКИ ПРОЙШЛИ")
    } else {
        print("ПРОВАЛЕНО ПЕРЕВІРОК: " + toString(fail))
    }
}
main()
